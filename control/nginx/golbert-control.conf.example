limit_req_zone $binary_remote_addr zone=golbert_redeem:10m rate=10r/m;

server {
    listen 80;
    server_name licencia.tudominio.com;

    location = /health {
        proxy_pass http://127.0.0.1:9100;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /redeem {
        limit_req zone=golbert_redeem burst=5 nodelay;
        proxy_pass http://127.0.0.1:9100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 404;
    }
}
