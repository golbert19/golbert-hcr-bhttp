[Unit]
Description=Golbert BadVPN UDPGW
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/golbert-vps/golbert.env
ExecStart=/usr/local/bin/badvpn-udpgw --listen-addr ${BADVPN_BIND}:${BADVPN_PORT} --max-clients 512 --max-connections-for-client 8
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
